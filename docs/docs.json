{
  "$schema": "https://mintlify.com/docs.json",
  "name": "DeckHTML",
  "description": "DeckHTML developer documentation for HTML-to-PPTX workflows, API integration, MCP tooling, SDK usage, and automation guides.",
  "theme": "maple",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/docs/quick-start"
  },
  "favicon": "/favicon.ico",
  "background": {
    "color": {
      "light": "#f7f8f6",
      "dark": "#090b0b"
    }
  },
  "fonts": {
    "family": "Plus Jakarta Sans",
    "heading": {
      "family": "Plus Jakarta Sans"
    }
  },
  "appearance": {
    "default": "light"
  },
  "contextual": {
    "options": [
      "copy",
      "claude",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "api": {
    "openapi": "reference/默认模块.openapi.json",
    "playground": {
      "display": "interactive"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/quick-start",
      "permanent": true
    },
    {
      "source": "/quickstart",
      "destination": "/docs/quick-start",
      "permanent": true
    },
    {
      "source": "/concepts",
      "destination": "/docs/concepts",
      "permanent": true
    },
    {
      "source": "/architecture",
      "destination": "/docs/architecture",
      "permanent": true
    },
    {
      "source": "/local-mode",
      "destination": "/docs/local-mode",
      "permanent": true
    },
    {
      "source": "/cloud-mode",
      "destination": "/docs/cloud-mode",
      "permanent": true
    },
    {
      "source": "/configuration",
      "destination": "/docs/configuration",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/docs/faq",
      "permanent": true
    },
    {
      "source": "/errors",
      "destination": "/docs/errors",
      "permanent": true
    },
    {
      "source": "/cli/index",
      "destination": "/cli/overview",
      "permanent": true
    },
    {
      "source": "/sdk/index",
      "destination": "/sdk/overview",
      "permanent": true
    },
    {
      "source": "/mcp/index",
      "destination": "/mcp/overview",
      "permanent": true
    },
    {
      "source": "/skill/index",
      "destination": "/skills/overview",
      "permanent": true
    },
    {
      "source": "/skill/deckhtml",
      "destination": "/skills/deckhtml",
      "permanent": true
    },
    {
      "source": "/reference/create-html2pptx-task",
      "destination": "/reference/submit-async-task",
      "permanent": true
    },
    {
      "source": "/reference/get-task-details",
      "destination": "/reference/query-task-status",
      "permanent": true
    }
  ],
  "colors": {
    "primary": "#0f766e",
    "light": "#34d399",
    "dark": "#14b8a6"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "navbar": {
          "primary": {
            "type": "button",
            "label": "Get Started",
            "href": "https://app.deckflow.com/?initent=sign-up"
          }
        },
        "tabs": [
          {
            "tab": "Developer Guide",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "docs/quick-start",
                  "docs/overview",
                  "docs/concepts",
                  "docs/architecture"
                ]
              },
              {
                "group": "Operations",
                "pages": [
                  "docs/local-mode",
                  "docs/cloud-mode",
                  "docs/configuration",
                  "docs/faq"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "reference/overview",
                  "reference/authentication-and-task-model"
                ]
              },
              {
                "group": "Core APIs",
                "pages": [
                  "reference/submit-async-task",
                  "reference/query-task-status",
                  "reference/download-task-result"
                ]
              },
              {
                "group": "Scenario Guides",
                "pages": [
                  "reference/generation-scenarios",
                  "reference/translation-scenarios",
                  "reference/revamp-scenarios",
                  "reference/tool-api-scenarios"
                ]
              }
            ]
          },
          {
            "tab": "MCP",
            "groups": [
              {
                "group": "MCP",
                "pages": [
                  "mcp/overview",
                  "mcp/tools",
                  "mcp/codex",
                  "mcp/cursor",
                  "mcp/claude-code"
                ]
              }
            ]
          },
          {
            "tab": "Skills",
            "groups": [
              {
                "group": "Skills",
                "pages": [
                  "skills/overview",
                  "skills/deckhtml"
                ]
              }
            ]
          },
          {
            "tab": "CLI",
            "groups": [
              {
                "group": "CLI",
                "pages": [
                  "cli/overview",
                  "cli/output-modes",
                  "cli/commands",
                  "cli/features",
                  "cli/examples"
                ]
              }
            ]
          },
          {
            "tab": "SDK",
            "groups": [
              {
                "group": "SDK",
                "pages": [
                  "sdk/overview",
                  "sdk/node"
                ]
              }
            ]
          }
        ]
      },
