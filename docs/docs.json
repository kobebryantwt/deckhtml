{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Deckflow",
  "description": "Developer documentation for DeckProbe, DeckRender, DeckOps, DeckUse, and DeckHTML.",
  "theme": "maple",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/introduction"
  },
  "favicon": "/favicon.ico",
  "background": {
    "color": {
      "light": "#f7f8f6",
      "dark": "#090b0b"
    }
  },
  "fonts": {
    "family": "Plus Jakarta Sans",
    "heading": {
      "family": "Plus Jakarta Sans"
    }
  },
  "appearance": {
    "default": "light"
  },
  "contextual": {
    "options": ["copy", "claude", "cursor", "vscode"]
  },
  "api": {
    "openapi": "platform/api/default-module.openapi.json",
    "playground": {
      "display": "interactive"
    }
  },
  "redirects": [
    { "source": "/", "destination": "/introduction", "permanent": true },
    { "source": "/quickstart", "destination": "/deckhtml/quick-start", "permanent": true },
    { "source": "/concepts", "destination": "/product-guide", "permanent": true },
    { "source": "/architecture", "destination": "/runtime-architecture", "permanent": true },
    { "source": "/getting-started/overview", "destination": "/introduction", "permanent": true },
