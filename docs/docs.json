{
  "name": "DeckHTML",
  "description": "DeckHTML developer documentation for HTML-to-PPTX workflows, API integration, MCP tooling, SDK usage, and automation guides.",
  "theme": "mint",
  "logo": {
    "light": "/deckhtml-for-developers-light.png",
    "dark": "/deckhtml-for-developers-dark.png",
    "href": "/docs/quick-start"
  },
  "favicon": "/favicon.ico",
  "api": {
    "openapi": "reference/默认模块.openapi.json",
    "playground": {
      "display": "interactive"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/quick-start",
      "permanent": true
    },
    {
      "source": "/quickstart",
      "destination": "/docs/quick-start",
      "permanent": true
    },
    {
      "source": "/concepts",
      "destination": "/docs/concepts",
      "permanent": true
    },
    {
      "source": "/architecture",
      "destination": "/docs/architecture",
      "permanent": true
    },
    {
      "source": "/local-mode",
      "destination": "/docs/local-mode",
      "permanent": true
    },
    {
      "source": "/cloud-mode",
      "destination": "/docs/cloud-mode",
      "permanent": true
    },
    {
      "source": "/configuration",
      "destination": "/docs/configuration",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/docs/faq",
      "permanent": true
    },
    {
      "source": "/errors",
      "destination": "/docs/errors",
      "permanent": true
    },
    {
      "source": "/cli/index",
      "destination": "/cli/overview",
      "permanent": true
    },
    {
      "source": "/sdk/index",
      "destination": "/sdk/overview",
      "permanent": true
    },
    {
      "source": "/mcp/index",
      "destination": "/mcp/overview",
      "permanent": true
    },
    {
      "source": "/skill/index",
      "destination": "/skills/overview",
      "permanent": true
    },
    {
      "source": "/skill/deckhtml",
      "destination": "/skills/deckhtml",
      "permanent": true
    }
  ],
  "colors": {
    "primary": "#0f766e",
    "light": "#34d399",
    "dark": "#14b8a6"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "navbar": {
          "primary": {
            "type": "button",
            "label": "Quickstart",
            "href": "/docs/quick-start"
          }
        },
        "tabs": [
          {
            "tab": "Developer Guide",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "docs/quick-start",
                  "docs/overview",
                  "docs/concepts",
                  "docs/architecture"
                ]
              },
              {
                "group": "Operations",
                "pages": [
                  "docs/local-mode",
                  "docs/cloud-mode",
                  "docs/configuration",
                  "docs/faq",
                  "docs/errors"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Default Module",
                "openapi": "reference/默认模块.openapi.json"
              }
            ]
          },
          {
            "tab": "MCP",
            "groups": [
              {
                "group": "MCP",
                "pages": [
                  "mcp/overview",
                  "mcp/tools",
                  "mcp/codex",
                  "mcp/cursor",
                  "mcp/claude-code"
                ]
              }
            ]
          },
          {
            "tab": "Skills",
            "groups": [
              {
                "group": "Skills",
                "pages": [
                  "skills/overview",
                  "skills/deckhtml"
                ]
              }
            ]
          },
          {
            "tab": "CLI",
            "groups": [
              {
                "group": "CLI",
                "pages": [
                  "cli/overview",
                  "cli/commands",
                  "cli/features",
                  "cli/examples",
                  "cli/output-modes"
                ]
              }
            ]
          },
          {
            "tab": "SDK",
            "groups": [
              {
                "group": "SDK",
                "pages": [
                  "sdk/overview",
                  "sdk/node",
                  "sdk/python"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "zh",
        "navbar": {
          "primary": {
            "type": "button",
            "label": "快速开始",
            "href": "/zh/docs/quick-start"
          }
        },
        "tabs": [
          {
            "tab": "开发指南",
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/docs/quick-start",
                  "zh/docs/overview"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "pages": [
              "zh/reference/overview"
            ]
          },
          {
            "tab": "MCP",
            "pages": [
              "zh/mcp/overview"
            ]
          },
          {
            "tab": "扩展",
            "pages": [
              "zh/skills/overview"
            ]
          },
          {
            "tab": "CLI",
            "pages": [
              "zh/cli/overview"
            ]
          },
          {
            "tab": "SDK",
            "pages": [
              "zh/sdk/overview"
            ]
          }
        ]
      }
    ]
  }
}
